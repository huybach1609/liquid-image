# Maintainer: huybach1609 <huybach1609@gmail.com>
pkgname=liquid-image-bin
pkgver=0.1.5
pkgrel=1
pkgdesc="A modern desktop batch image processor and converter built with Tauri v2 (precompiled binary)"
arch=('x86_64')
url="https://github.com/huybach1609/liquid-image"
license=('MIT')

provides=('liquid-image')
conflicts=('liquid-image')

depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'openssl'
  'hicolor-icon-theme'
  'imagemagick'
)

source_x86_64=("$pkgname-$pkgver.deb::$url/releases/download/v$pkgver/liquid-image_${pkgver}_amd64.deb")
sha256sums_x86_64=('a0229ef730962c1ee3c4c8e887e2387511e5a9bca7c5932ce938056b861e268f')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir/"
  # Remove bundled magick binary to prevent file conflict with Arch's official imagemagick package
  rm -f "$pkgdir/usr/bin/magick"
}
