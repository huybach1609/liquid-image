# Maintainer: huybach1609 <huybach1609@gmail.com>
pkgname=liquid-image
pkgver=0.1.4
pkgrel=1
pkgdesc="A modern desktop batch image processor and converter built with Tauri v2"
arch=('x86_64' 'aarch64')
url="https://github.com/huybach1609/liquid-image"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'openssl'
  'hicolor-icon-theme'
  'imagemagick'
)
makedepends=(
  'cargo'
  'rust'
  'bun'
  'pkg-config'
)
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('04990d06bcf410d5435cd19a21f28bd8370dacf157ffaf2989717a8c1f6e6e02')

build() {
  cd "$pkgname-$pkgver"
  bun install --frozen-lockfile
  bun tauri build --no-bundle
}

package() {
  cd "$pkgname-$pkgver"

  # Install binary executable
  install -Dm755 "src-tauri/target/release/liquid-image" "$pkgdir/usr/bin/liquid-image"

  # Install App Icons
  install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/liquid-image.png"
  install -Dm644 "src-tauri/icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/liquid-image.png"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/liquid-image.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/liquid-image.png"
  install -Dm644 "src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/liquid-image.png"
  install -Dm644 "public/app-icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/liquid-image.svg"

  # Install Desktop Entry launcher
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/liquid-image.desktop" << END
[Desktop Entry]
Type=Application
Name=Liquid Image
Comment=$pkgdesc
Exec=liquid-image %F
Icon=liquid-image
Terminal=false
MimeType=image/jpeg;image/png;image/webp;image/avif;image/gif;image/tiff;image/bmp;image/svg+xml;image/x-icon;image/heic;image/heif;
Categories=Graphics;Photography;Utility;
END
}
